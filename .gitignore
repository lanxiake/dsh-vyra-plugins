node_modules/
# Touched by an incidental `pnpm install` in this repository, which owns no
# dependencies of its own; the plugin packages are installed by their consumers.
pnpm-lock.yaml
pnpm-workspace.yaml

# Python bytecode from local worker tests
__pycache__/
*.pyc

# vyra-free-model preview artefacts
plugins/vyra-free-model/.preview.html
plugins/vyra-free-model/.preview.png
plugins/vyra-free-model/.preview-expanded.html
plugins/vyra-free-model/.preview-shot.png
plugins/vyra-free-model/.preview-expanded.png

# site build artifacts
web/dist/
web/node_modules/
web/public/site/
.cache/sources/

# IDE
.idea/

# WorkBuddy 会话记忆与项目数据
.workbuddy/

# AgentTeams runtime state: per-session rosters, task boards and archives. It is
# machine- and run-specific and regenerated by the runtime, so it never belongs
# in the repository.
.agent-teams/

# Scratch file written by the tool-usage dashboard while it rebuilds its stats;
# the real artefact is whatever that job publishes, not this temp name.
.am-stats.new.js
