      "title": {
        "en": "Agent Manager",
        "zh": "智能体管理"
      },
      "description": {
        "en": "Create and manage agents in a panel instead of a config file: each one gets its own prompt, capability set, tool restrictions and preferred skills, and the main agent can create them for you.",
