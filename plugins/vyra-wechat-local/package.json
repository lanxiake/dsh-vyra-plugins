{
  "name": "vyra-wechat-local",
  "version": "0.2.0",
  "type": "module",
  "description": "本机微信：读取用户本人微信的会话与聊天记录，必要时以本人身份发送。仅 Windows。",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/sidecar.test.js test/tools.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "vendor",
    "assets/qq-group.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "weixin",
    "local"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanxiake/dsh-vyra-plugins.git",
    "directory": "plugins/vyra-wechat-local"
  }
}