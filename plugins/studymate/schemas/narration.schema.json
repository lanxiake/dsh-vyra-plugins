{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Narration",
  "description": "从 lessons/<NNNN>-<节点id>.narration.md 解析出来的旁白结构。旁白由 learning-coach 与课件同源写；这里只描述解析结果的形状。",
  "type": "object",
  "required": ["version", "title", "instruction", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string" },
    "instruction": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "text", "paragraphs"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}