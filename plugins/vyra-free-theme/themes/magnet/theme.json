{
  "schema": 1,
  "id": "magnet",
  "version": "0.1.0",
  "author": "vyra",
  "name": {
    "zh": "纸与磁点",
    "en": "Paper & magnets"
  },
  "brand": {
    "title": {
      "zh": "纸与磁点",
      "en": "Paper & magnets"
    },
    "slogans": {
      "zh": "一千个点，慢慢转身",
      "en": "A thousand dots, turning slowly"
    },
    "heroMark": "text"
  },
  "colors": {
    "light": {
      "--dsw-alias-bg-base": "#F4F1EA",
      "--dsw-alias-bg-layer-1": "#FBF9F4",
      "--dsw-alias-bg-layer-2": "#E9E4D8",
      "--dsw-alias-bg-layer-3": "#DCD6C6",
      "--dsw-alias-bg-module-platform": "#EFEBE1",
      "--dsw-specific-sidebar-fill": "#F0ECE2",
      "--dsw-alias-brand-primary": "#0B7F72",
      "--dsw-alias-label-primary": "#1E2A2F",
      "--dsw-alias-label-secondary": "rgba(30, 42, 47, 0.72)",
      "--dsw-alias-border-l1": "rgba(11, 127, 114, 0.18)"
    },
    "dark": {
      "--dsw-alias-bg-base": "#181A1D",
      "--dsw-alias-bg-layer-1": "#202327",
      "--dsw-alias-bg-layer-2": "#292D33",
      "--dsw-alias-bg-layer-3": "#343A41",
      "--dsw-alias-bg-module-platform": "#1C1F23",
      "--dsw-specific-sidebar-fill": "#1A1D21",
      "--dsw-alias-brand-primary": "#2AB2A0",
      "--dsw-alias-label-primary": "#E7E4DC",
      "--dsw-alias-label-secondary": "rgba(231, 228, 220, 0.72)",
      "--dsw-alias-border-l1": "rgba(42, 178, 160, 0.22)"
    }
  },
  "shape": {
    "--dsw-alias-radius-lg": "10px"
  },
  "translucency": {
    "web": 28,
    "desktop": 52
  },
  "wallpaper": {
    "kind": "image",
    "light": {
      "src": "assets/magnet-light.png"
    },
    "dark": {
      "src": "assets/magnet-dark.png"
    }
  },
  "sidebar": {
    "pack": "hairline"
  },
  "coverage": {
    "shell": true,
    "scopes": [
      "sidebar"
    ]
  }
}
