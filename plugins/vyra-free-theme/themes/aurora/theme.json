{
  "schema": 1,
  "id": "aurora",
  "version": "0.1.0",
  "author": "vyra",
  "name": {
    "zh": "极光",
    "en": "Aurora"
  },
  "brand": {
    "title": {
      "zh": "极光",
      "en": "Aurora"
    },
    "slogans": {
      "zh": "流体的光 · 缓慢呼吸",
      "en": "Light that breathes"
    }
  },
  "colors": {
    "light": {
      "--dsw-alias-bg-base": "#EEF6F5",
      "--dsw-alias-bg-layer-1": "#F7FCFB",
      "--dsw-alias-bg-layer-2": "#E2EDEC",
      "--dsw-alias-bg-layer-3": "#D4E2E1",
      "--dsw-alias-bg-module-platform": "#EAF2F1",
      "--dsw-specific-sidebar-fill": "#E9F1F0",
      "--dsw-alias-brand-primary": "#1E7A6B",
      "--dsw-alias-label-primary": "#16211F",
      "--dsw-alias-label-secondary": "rgba(22, 33, 31, 0.72)",
      "--dsw-alias-border-l1": "rgba(30, 122, 107, 0.18)"
    },
    "dark": {
      "--dsw-alias-bg-base": "#080E12",
      "--dsw-alias-bg-layer-1": "#0F1720",
      "--dsw-alias-bg-layer-2": "#16212C",
      "--dsw-alias-bg-layer-3": "#1E2B38",
      "--dsw-alias-bg-module-platform": "#111A22",
      "--dsw-specific-sidebar-fill": "#0C141B",
      "--dsw-alias-brand-primary": "#4FD3BE",
      "--dsw-alias-label-primary": "#E8F2F1",
      "--dsw-alias-label-secondary": "rgba(232, 242, 241, 0.72)",
      "--dsw-alias-border-l1": "rgba(79, 211, 190, 0.20)"
    }
  },
  "shape": {
    "--dsw-alias-radius-lg": "18px"
  },
  "translucency": {
    "web": 40,
    "desktop": 66
  },
  "wallpaper": {
    "kind": "video",
    "light": {
      "src": "assets/aurora-light.mp4",
      "poster": "assets/aurora-light.png"
    }
  },
  "sidebar": {
    "pack": "neon"
  },
  "coverage": {
    "shell": true,
    "scopes": [
      "sidebar"
    ]
  }
}
