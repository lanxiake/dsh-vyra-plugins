{
  "schema": 1,
  "id": "liquid",
  "version": "0.1.0",
  "author": "vyra",
  "name": {
    "zh": "液态紫",
    "en": "Liquid violet"
  },
  "brand": {
    "title": {
      "zh": "液态紫",
      "en": "Liquid violet"
    },
    "slogans": {
      "zh": "形状自己流动",
      "en": "Shape that flows"
    },
    "heroMark": "ring"
  },
  "colors": {
    "light": {
      "--dsw-alias-bg-base": "#F3EFFB",
      "--dsw-alias-bg-layer-1": "#FBF8FF",
      "--dsw-alias-bg-layer-2": "#E9E2F8",
      "--dsw-alias-bg-layer-3": "#DCD2F0",
      "--dsw-alias-bg-module-platform": "#EFE9FA",
      "--dsw-specific-sidebar-fill": "#EDE6FA",
      "--dsw-alias-brand-primary": "#5B3FE0",
      "--dsw-alias-label-primary": "#171225",
      "--dsw-alias-label-secondary": "rgba(23, 18, 37, 0.72)",
      "--dsw-alias-border-l1": "rgba(91, 63, 224, 0.16)"
    },
    "dark": {
      "--dsw-alias-bg-base": "#0A0713",
      "--dsw-alias-bg-layer-1": "#120C1F",
      "--dsw-alias-bg-layer-2": "#1A1230",
      "--dsw-alias-bg-layer-3": "#241A40",
      "--dsw-alias-bg-module-platform": "#0E0A18",
      "--dsw-specific-sidebar-fill": "#0B0817",
      "--dsw-alias-brand-primary": "#8B6BFF",
      "--dsw-alias-label-primary": "#EDE8FF",
      "--dsw-alias-label-secondary": "rgba(237, 232, 255, 0.72)",
      "--dsw-alias-border-l1": "rgba(139, 107, 255, 0.22)"
    }
  },
  "shape": {
    "--dsw-alias-radius-lg": "20px"
  },
  "translucency": {
    "web": 46,
    "desktop": 70
  },
  "wallpaper": {
    "kind": "video",
    "dark": {
      "src": "assets/liquid-dark.mp4",
      "poster": "assets/liquid-dark.png"
    }
  },
  "sidebar": {
    "pack": "obsidian"
  },
  "coverage": {
    "shell": true,
    "scopes": [
      "sidebar"
    ]
  }
}
