    "odx": "./bin/odx"
  },
  "files": [
    "index.js",
    "client.js",
    "skills.mjs",
    "domains.mjs",
    "config.mjs",
    "agents.mjs",
    "sync.mjs",
    "state.mjs",
    "routes.mjs",
    "cli.mjs",
    "bin",
    "cordis.patch.yml",
    "vendor",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "icon.svg",
    "assets/qq-group.png"
