{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaManifest",
  "description": "一种学习产物（音频 / 视频 / 游戏）的清单。记录源文件哈希、产物文件、章节与告警；阅读端据此判断是否存在与是否过期。",
  "type": "object",
  "required": ["version", "kind", "subject", "createdAt", "generator", "source", "files", "warnings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "kind": { "enum": ["audio", "video", "game"] },
    "subject": { "type": "string", "minLength": 1 },
    "node": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lesson": { "type": "string" },
        "quiz": { "type": "string" },
        "narration": { "type": "string" },
        "lessonSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "quizSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "narrationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "curriculumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "lessonSha256"],
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "lessonSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "quizSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "mime"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "mime": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "startMs", "endMs", "sceneId"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "sceneId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "durationMs": { "type": "integer", "minimum": 0 },
    "provider": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "voice": { "type": "string" },
        "model": { "type": "string" },
        "rate": { "type": "string" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}