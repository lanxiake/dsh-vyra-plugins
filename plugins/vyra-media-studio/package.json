{
  "name": "vyra-media-studio",
  "version": "0.2.5",
  "type": "module",
  "description": "右侧栏文件管理：默认本会话时间线、拖动移动、单按钮切换视图、资源管理器打开。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "assets/qq-group.png"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test.mjs test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "media",
    "video",
    "audio",
    "files",
    "file-manager",
    "gallery"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanxiake/dsh-vyra-plugins.git",
    "directory": "plugins/vyra-media-studio"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "mime-types": "^3.0.2",
    "range-parser": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.577.0",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yet-another-react-lightbox": "^3.33.1"
  }
}
