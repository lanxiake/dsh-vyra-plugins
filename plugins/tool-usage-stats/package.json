{
  "name": "dsh-vyra-tool-usage-stats",
  "version": "0.7.5",
  "description": "统计每次工具调用与失败原因；勾选出问题的工具，一键复制其失败日志与分析提示词粘进对话。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stats",
    "tool-usage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanxiake/dsh-vyra-plugins.git",
    "directory": "plugins/tool-usage-stats"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "assets/qq-group.png"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
