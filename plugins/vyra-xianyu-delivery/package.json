{
  "name": "vyra-xianyu-delivery",
  "version": "0.1.1",
  "icon": "./icon.svg",
  "type": "module",
  "description": "闲鱼虚拟商品自动发货：轮询待发货订单，匹配卡密，确认发货并发送内容",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "vendor",
    "assets/qq-group.png",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "xianyu",
    "goofish",
    "auto-delivery"
  ],
  "license": "MIT"
}
