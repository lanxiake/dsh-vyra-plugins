{
  "name": "vyra-xianyu-delivery",
  "version": "0.6.0",
  "icon": "./icon.svg",
  "type": "module",
  "description": "闲鱼虚拟商品自动客服：实时监听买家消息，自动发货，并用 DSH agent + 技能回答买家问题",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "vendor",
    "assets/qq-group.png",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "xianyu",
    "goofish",
    "auto-delivery"
  ],
  "license": "MIT"
}
