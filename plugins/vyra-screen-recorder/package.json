{
  "name": "dsh-vyra-screen-recorder",
  "version": "0.4.5",
  "type": "module",
  "description": "DSH 录屏与截图：工具栏选择整个桌面 / 显示器 / 窗口 / 自定义区域，录系统声音与麦克风，WebCodecs 编成 MP4 / WebM；截图带选区与标注、一键提取文字与复制图片/文件（Windows 自带 OCR，可接 dsh-tool-ocr 引擎）、悬停显示快捷键、设置页、快捷键和文件管理。",
  "main": "./index.js",
  "bin": {
    "vsr": "bin/vsr.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "skills",
    "lib",
    "src",
    "scripts",
    "vendor",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "native"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "fix:bom": "node scripts/fix-bom.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/fix-bom.mjs --check",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build:wgcrec": "node scripts/build-wgcrec.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screen-recorder",
    "screenshot",
    "webcodecs",
    "ocr",
    "clipboard",
    "录屏",
    "截图",
    "文字识别",
    "取字",
    "剪贴板"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanxiake/dsh-vyra-plugins.git",
    "directory": "plugins/vyra-screen-recorder"
  }
}
