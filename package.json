{
  "name": "dsh-vyra-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin and skill market maintained by the dsh-Veyra fork.",
  "scripts": {
    "build:index": "tsx scripts/build-index.ts",
    "build:stats": "node scripts/build-stats.mjs",
    "verify:index": "tsx scripts/verify-index.ts",
    "verify": "pnpm run contact && pnpm run check:installable && pnpm run build:index && pnpm run verify:index",
    "print:skills": "tsx scripts/print-skill-config.ts",
    "test:market": "node --check plugins/vyra-plugin-market/cli.mjs && node plugins/vyra-plugin-market/test.mjs && node plugins/vyra-plugin-market/render-check.mjs",
    "test:studymate-media": "node --experimental-strip-types plugins/studymate/scripts/tests/test_media_script.mjs && node --experimental-strip-types plugins/studymate/scripts/tests/test_media_tts.mjs",
    "media:plan": "node --experimental-strip-types plugins/studymate/scripts/media-plan.mjs",
    "media:audio": "node --experimental-strip-types plugins/studymate/scripts/media-audio.mjs",
    "typecheck": "tsc --noEmit",
    "check:installable": "node scripts/check-installable.mjs",
    "contact": "node scripts/add-contact-block.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
